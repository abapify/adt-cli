# syntax=docker/dockerfile:1.7
#
# Dockerfile.mcp — production image for the @abapify/adt-mcp HTTP server.
#
# Build:
#   docker build -f Dockerfile.mcp -t ghcr.io/abapify/adt-mcp:latest .
#
# Behind a corporate npm proxy (e.g. JFrog Artifactory) pass the registry
# URL as a build arg instead of committing it:
#   docker build -f Dockerfile.mcp \
#     --build-arg BUN_CONFIG_REGISTRY="$BUN_CONFIG_REGISTRY" \
#     -t adt-mcp:local .
#
# Run (TLS material is mandatory — mount a cert and key). The container
# runs as uid 10001, so the mounted key must be readable by it — keep the
# key at mode 600 and assign it to the container uid
# (`sudo chown 10001:10001 key.pem`), or run with your own uid via
# `--user "$(id -u):$(id -g)"`:
#   docker run --rm -p 3000:3000 \
#     -v "$PWD/cert.pem:/app/cert.pem:ro" \
#     -v "$PWD/key.pem:/app/key.pem:ro" \
#     -e MCP_TLS_CERT=/app/cert.pem \
#     -e MCP_TLS_KEY=/app/key.pem \
#     -e MCP_AUTH_TOKEN="$(openssl rand -hex 32)" \
#     -e MCP_ALLOWED_HOSTS=localhost,127.0.0.1 \
#     ghcr.io/abapify/adt-mcp:latest
#
# ── Stage 1: builder ────────────────────────────────────────────────────────
FROM node:24-bookworm AS builder

ARG BUN_CONFIG_REGISTRY
ENV BUN_CONFIG_REGISTRY=${BUN_CONFIG_REGISTRY}

# Install bun (matches the version used by CI).
RUN npm install -g bun@1.3.14

WORKDIR /build

# Copy workspace manifests first for better layer caching.
COPY package.json bun.lock nx.json tsconfig.base.json tsconfig.json tsdown.config.ts ./

# Copy all workspace members required for the build.
COPY packages/ ./packages/
COPY tools/    ./tools/
COPY samples/  ./samples/
# website/ is declared in root workspaces but is a docs-only project; copy just
# its package.json so `bun install --frozen-lockfile` can resolve the workspace.
COPY website/package.json ./website/package.json

# Install every workspace dependency (dev deps are required for the build).
RUN bun install --frozen-lockfile

# Nx tweaks for containerised builds.
ENV NX_DAEMON=false
ENV NX_TUI=false

# Build adt-mcp (Nx respects the dependency graph, so all transitive
# workspace packages are built in the correct order).
RUN npx nx build adt-mcp

# ── Stage 2: runtime ────────────────────────────────────────────────────────
FROM node:24-bookworm-slim AS runtime

LABEL org.opencontainers.image.title="adt-mcp" \
      org.opencontainers.image.description="MCP (Model Context Protocol) HTTP server for SAP ABAP Development Tools" \
      org.opencontainers.image.source="https://github.com/abapify/adt-cli" \
      org.opencontainers.image.licenses="MIT"

WORKDIR /app

# ca-certificates is required so the server can validate upstream TLS
# endpoints (e.g. OIDC JWKS) and so the healthcheck has a base CA bundle.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create an unprivileged user. uid/gid 10001 is outside the usual ranges
# and is a common convention for container app users.
RUN groupadd --system --gid 10001 appuser \
    && useradd  --system --uid 10001 --gid appuser --home-dir /app appuser

# Copy the built workspace packages and the workspace node_modules so the
# @abapify/* symlinks resolve at runtime. Owned by root, readable+executable
# by everyone — appuser falls in "others" (r-x) so cannot mutate these paths.
# Matches the Sonar docker:S6504 / CWE-732 compliant pattern.
COPY --from=builder --chown=root:root --chmod=755 /build/packages     ./packages
COPY --from=builder --chown=root:root --chmod=755 /build/node_modules ./node_modules
COPY --from=builder --chown=root:root --chmod=644 /build/package.json ./package.json

USER appuser

# MCP_HEALTH_HOST is the TLS servername the healthcheck verifies — set it
# to a DNS SAN on your certificate if it is not `localhost`.
# MCP_HEALTH_CA optionally points at an extra CA bundle (container path)
# the probe also trusts, for leaf certs issued by a private CA.
ENV NODE_ENV=production \
    MCP_HOST=0.0.0.0 \
    MCP_PORT=3000 \
    MCP_HEALTH_HOST=localhost

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "const h=require('node:https'),t=require('node:tls'),f=require('node:fs');let ca=[...t.rootCertificates];for(const p of[process.env.MCP_TLS_CERT,process.env.MCP_HEALTH_CA]){if(p&&f.existsSync(p))ca.push(f.readFileSync(p,'utf8'))}h.get({host:'127.0.0.1',servername:process.env.MCP_HEALTH_HOST||'localhost',port:process.env.MCP_PORT||3000,path:'/healthz',ca},r=>{r.resume();process.exit(r.statusCode===200?0:1)}).on('error',()=>process.exit(1))" || exit 1

# Default CMD runs the Streamable HTTP entry-point. Override with
# `docker run ... adt-mcp` to run the stdio transport instead.
CMD ["node", "/app/packages/adt-mcp/dist/bin/adt-mcp-http.mjs", "--host", "0.0.0.0"]
