# abapify Pilot — dev environment configuration
# Copy this file to .env and fill in the values.
# .env is gitignored; this file is safe to commit.

# ─── LLM (LiteLLM proxy) ──────────────────────────────────────────────────────
# Base URL of your LiteLLM proxy (OpenAI-compatible API).
LITELLM_BASE_URL=http://127.0.0.1:4000

# API key forwarded to LiteLLM.
LITELLM_API_KEY=sk-your-litellm-key

# Model name as understood by LiteLLM (e.g. openai/gpt-4o, anthropic/claude-3-5-sonnet).
MODEL=openai/gpt-4o

# ─── MCP server ───────────────────────────────────────────────────────────────
# URL of the running adt-mcp HTTPS server.
# When using `bun run dev:pilot` both servers start together; this default works.
MCP_SERVER_URL=https://127.0.0.1:3001/mcp

# ─── adt-mcp server settings ──────────────────────────────────────────────────
# Port for the adt-mcp Streamable HTTP server.
MCP_PORT=3001

# Bind address for adt-mcp. Use 127.0.0.1 for local-only access.
MCP_HOST=127.0.0.1

# Allow CORS from the Mastra Playground (localhost:4112).
MCP_CORS_ORIGIN=http://localhost:4112

# TLS is mandatory for adt-mcp-http. These paths are for the dev serve
# target only — Docker Compose reads .env.mcp instead (see
# .env.mcp.example); do NOT point compose at this file.
# Generate a dev pair once from the repo root (key.pem/cert.pem are
# covered by .gitignore so the private key cannot be committed):
#   openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 \
#     -keyout key.pem -out cert.pem -days 365 -nodes \
#     -subj "/CN=localhost" -addext "subjectAltName=IP:127.0.0.1,DNS:localhost"
# Paths are relative to packages/adt-mcp/ (the serve target's cwd).
MCP_TLS_CERT=../../cert.pem
MCP_TLS_KEY=../../key.pem
# NOTE: NODE_EXTRA_CA_CERTS is deliberately NOT here — Node reads it only at
# process start, before dotenv/.env files are applied. Export it in your
# shell instead:  export NODE_EXTRA_CA_CERTS="$PWD/cert.pem"

# ─── adt-mcp multi-system config ──────────────────────────────────────────────
# Path to your adt.config.ts or adt.config.json (SAP system definitions).
# When set, destinations from adt-config are registered in the MCP multi-system registry.
# Credentials are NOT stored — supply them at runtime via sap_connect.
# Relative to packages/adt-mcp/ (or use absolute path).
ADT_CONFIG_FILE=../../adt.config.ts
