{
  "name": "abapify",
  "version": "0.1.1",
  "private": true,
  "description": "TypeScript libraries and CLI tools for modern SAP ABAP development workflows. Build CLI-first development tools, integrate ABAP with modern CI/CD pipelines, and work with SAP systems programmatically.",
  "license": "MIT",
  "author": "",
  "type": "module",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "workspaces": [
    "packages/*",
    "samples/*",
    "tools/*",
    "e2e/*",
    "packages/plugins/*",
    "website"
  ],
  "scripts": {
    "prepare": "husky",
    "precommit": "nx format:check --uncommitted",
    "devcontainer": "devcontainer up --workspace-folder=$(pwd)",
    "preversion": "npx nx release version ${npm_new_version}",
    "knip": "knip",
    "dev:pilot": "bunx concurrently -k -s first \"bunx nx run adt-mcp:serve\" \"bunx mastra dev --dir src/mastra --env .env\""
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,md,mdx,json,jsonc,yml,yaml,css,scss,html}": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@fission-ai/openspec": "^1.14.3",
    "@nx/devkit": "24.0.2",
    "@xmldom/xmldom": "^0.9.12",
    "axios": "^1.20.0",
    "dset": "^3.1.4",
    "fast-xml-parser": "^5.11.2",
    "fxmlp": "^1.0.7",
    "nx-mcp": "^0.25.0",
    "open": "^11.0.4",
    "openid-client": "^6.8.8",
    "qs": "^6.16.1",
    "reflect-metadata": "^0.2.2",
    "ts-morph": "^28.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@abapify/adt-atc": "workspace:*",
    "@abapify/adt-aunit": "workspace:*",
    "@abapify/adt-cli": "workspace:*",
    "@abapify/adt-codegen": "workspace:*",
    "@abapify/adt-config": "workspace:*",
    "@abapify/adt-export": "workspace:*",
    "@abapify/adt-playwright": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@nx-devkit/nx-cloud": "0.0.17",
    "@nx-devkit/typescript": "0.2.18",
    "@nx/eslint": "24.0.2",
    "@nx/eslint-plugin": "24.0.2",
    "@nx/jest": "24.0.2",
    "@nx/js": "24.0.2",
    "@nx/node": "24.0.2",
    "@nx/plugin": "24.0.2",
    "@nx/rollup": "24.0.2",
    "@nx/vite": "24.0.2",
    "@nx/vitest": "24.0.2",
    "@nx/web": "24.0.2",
    "@prettier/plugin-xml": "^3.4.2",
    "@swc-node/register": "~1.12.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "~1.15.47",
    "@swc/helpers": "~0.5.23",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "@typescript-eslint/parser": "8.70.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jest": "30.5.1",
    "jest-environment-jsdom": "30.5.1",
    "jest-environment-node": "^30.5.2",
    "jest-util": "30.5.1",
    "jiti": "2.7.0",
    "jsonc-eslint-parser": "^3.3.0",
    "knip": "^6.42.1",
    "lint-staged": "^17.6.0",
    "nx": "24.0.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "rollup": "4.63.1",
    "swc-loader": "0.2.7",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "tsdown": "^0.22.14",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.70.0",
    "verdaccio": "6.10.3",
    "vite": "8.2.4",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "handlebars": "^4.7.10",
    "tinypool": "^2.2.0",
    "basic-ftp": "^6.2.3",
    "axios": "^1.20.0",
    "brace-expansion": "^5.0.12",
    "compression": "^1.8.2",
    "follow-redirects": "^1.16.1",
    "serialize-javascript": "^7.1.2",
    "smol-toml": "^1.9.1",
    "qs": "^6.16.1",
    "postcss-selector-parser": "^7.1.7",
    "uuid": "^11.1.1",
    "@verdaccio/config": {
      "js-yaml": "5.5.0"
    },
    "nx": {
      "undici": "7.29.1"
    },
    "webpack": "~5.105.4"
  },
  "exports": {
    ".": "./packages/adk/dist/index.mjs",
    "./package.json": "./package.json"
  }
}
