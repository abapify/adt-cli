{
  "name": "adt-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/adt-server/src",
  "projectType": "application",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["{projectRoot}"]
    }
  },
  "tags": ["scope:adt", "type:server"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/adt-server",
        "command": "NODE_OPTIONS=--max-old-space-size=6144 tsc -p tsconfig.json --noEmit"
      },
      "cache": true,
      "inputs": ["default", "^default", "{workspaceRoot}/tsconfig.base.json"],
      "dependsOn": ["^build"]
    }
  }
}
