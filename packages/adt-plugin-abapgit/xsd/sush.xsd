<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.sap.com/abapxml" elementFormDefault="unqualified">

  
  <xs:include schemaLocation="types/sush.xsd" />

  
  <xs:redefine schemaLocation="asx.xsd">
    <xs:complexType name="AbapValuesType">
      <xs:complexContent>
        <xs:extension base="asx:AbapValuesType">
          <xs:sequence>
            <xs:element name="HEAD" type="asx:SushHeadType" minOccurs="0" />
                  
            <xs:element name="USOBX" minOccurs="0" type="UsobxType">
                    </xs:element>
                  
            <xs:element name="USOBT" minOccurs="0" type="UsobtType">
                    </xs:element>
                
          </xs:sequence>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:redefine>

  
  <xs:import schemaLocation="abapgit.xsd" />

<xs:complexType name="UsobxType">
                      <xs:sequence>
                        <xs:element name="item" type="asx:SushUsobxItemType" minOccurs="0" maxOccurs="unbounded" />
                      </xs:sequence>
                    </xs:complexType>
                  <xs:complexType name="UsobtType">
                      <xs:sequence>
                        <xs:element name="item" type="asx:SushUsobtItemType" minOccurs="0" maxOccurs="unbounded" />
                      </xs:sequence>
                    </xs:complexType>
                  </xs:schema>