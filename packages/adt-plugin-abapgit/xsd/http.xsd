<?xml version="1.0" encoding="UTF-8"?>
<!-- abapGit HTTP (HTTP Service) Schema -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:asx="http://www.sap.com/abapxml"
           elementFormDefault="unqualified">

  <xs:import namespace="http://www.sap.com/abapxml" schemaLocation="asx.xsd"/>
  <xs:include schemaLocation="abapgit.xsd"/>
  <xs:include schemaLocation="types/http.xsd"/>

  <xs:complexType name="HttpValuesType">
    <xs:all>
      <xs:element name="HTTPID" type="xs:string" minOccurs="0"/>
      <xs:element name="HTTPTEXT" type="HttpTextType" minOccurs="0"/>
      <xs:element name="HTTPHDL" type="HttpHdlType" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="HttpAbapType">
    <xs:sequence>
      <xs:element name="values" type="HttpValuesType"/>
    </xs:sequence>
    <xs:attribute name="version" type="xs:string" default="1.0"/>
  </xs:complexType>

  <xs:element name="abapGit">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="abap" type="HttpAbapType"/>
      </xs:sequence>
      <xs:attribute name="version" type="xs:string" use="required"/>
      <xs:attribute name="serializer" type="xs:string" use="required"/>
      <xs:attribute name="serializer_version" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
