<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:asx="http://www.sap.com/abapxml"
           elementFormDefault="unqualified">

  <xs:import namespace="http://www.sap.com/abapxml" schemaLocation="asx.xsd"/>
  <xs:include schemaLocation="abapgit.xsd"/>
  <xs:include schemaLocation="types/sicf.xsd"/>

  <xs:complexType name="SicfValuesType">
    <xs:sequence>
      <xs:element name="URL" type="xs:string" minOccurs="0"/>
      <xs:element name="ICFSERVICE" type="IcfServiceType" minOccurs="0"/>
      <xs:element name="ICFDOCU" type="IcfDocuType" minOccurs="0"/>
      <xs:element name="ICFHANDLER_TABLE" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="ICFHANDLER" type="IcfHandlerType" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="SOTS" type="SotsType" minOccurs="0"/>
      <xs:element name="SOTS_USE" type="SotsType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="SicfAbapType">
    <xs:sequence>
      <xs:element name="values" type="SicfValuesType"/>
    </xs:sequence>
    <xs:attribute name="version" type="xs:string" default="1.0"/>
  </xs:complexType>

  <xs:element name="abapGit">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="abap" type="SicfAbapType"/>
      </xs:sequence>
      <xs:attribute name="version" type="xs:string" use="required"/>
      <xs:attribute name="serializer" type="xs:string" use="required"/>
      <xs:attribute name="serializer_version" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
