    <xs:all>
      <xs:element name="OTYPE" type="xs:string" minOccurs="0"/>
      <xs:element name="OBJID" type="xs:string" minOccurs="0"/>
      <xs:element name="SHORT" type="xs:string" minOccurs="0"/>
