<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:complexType name="CmptHeaderType">
    <xs:all>
      <xs:element name="NAME" type="xs:string" minOccurs="0"/>
      <xs:element name="DESCRIPTION" type="xs:string" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="CmptType">
    <xs:sequence>
      <xs:element name="HEADER" type="CmptHeaderType" minOccurs="0"/>
      <!-- TYP_TEMPLATE body fields (STR_BODY etc.) pass through lax -->
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
