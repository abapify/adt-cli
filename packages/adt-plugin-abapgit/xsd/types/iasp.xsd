      <xs:element name="DEVCLASS" type="xs:string" minOccurs="0"/>
      <xs:element name="VERSION" type="xs:string" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="IaspParamItemType">
    <xs:all>
      <xs:element name="NAME" type="xs:string" minOccurs="0"/>
