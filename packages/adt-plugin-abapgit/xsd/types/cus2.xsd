<xs:complexType name="TitlesType">
          <xs:sequence>
            <xs:element name="item" type="Cus2AtrtItemType" minOccurs="0" maxOccurs="unbounded" />
          </xs:sequence>
        </xs:complexType>
      </xs:schema>