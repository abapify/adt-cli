      <xs:element name="TEXT" type="xs:string" minOccurs="0" />
    </xs:all>
  </xs:complexType>

  <xs:complexType name="Cus2Type">
    <xs:sequence>
      <xs:element name="HEADER" type="Cus2AtrhType" minOccurs="0" />
