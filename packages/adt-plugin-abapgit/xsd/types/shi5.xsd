<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:complexType name="Shi5HeaderType">
    <xs:all>
      <xs:element name="EXT_ID" type="xs:string" minOccurs="0"/>
      <xs:element name="TREE_ID" type="xs:string" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="Shi5TextItemType">
    <xs:all>
      <xs:element name="SPRAS" type="xs:string" minOccurs="0"/>
      <xs:element name="EXT_ID" type="xs:string" minOccurs="0"/>
      <xs:element name="TEXT" type="xs:string" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="Shi5Type">
    <xs:sequence>
      <xs:element name="HEADER" type="Shi5HeaderType" minOccurs="0"/>
      <xs:element name="TEXTS" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="item" type="Shi5TextItemType" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
