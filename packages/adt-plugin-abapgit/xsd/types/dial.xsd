<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:complexType name="DialTdctType">
    <xs:all>
      <xs:element name="DIALOGNAME" type="xs:string" minOccurs="0"/>
      <xs:element name="DYNR" type="xs:string" minOccurs="0"/>
      <xs:element name="PROG" type="xs:string" minOccurs="0"/>
      <xs:element name="SPRAS" type="xs:string" minOccurs="0"/>
      <xs:element name="DDTEXT" type="xs:string" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="DialDiaparType">
    <xs:all>
      <xs:element name="DNAM" type="xs:string" minOccurs="0"/>
      <xs:element name="DYNR" type="xs:string" minOccurs="0"/>
      <xs:element name="PARAM" type="xs:string" minOccurs="0"/>
      <xs:element name="DPNAM" type="xs:string" minOccurs="0"/>
      <xs:element name="DTYPE" type="xs:string" minOccurs="0"/>
      <xs:element name="DPLEN" type="xs:string" minOccurs="0"/>
      <xs:element name="P_TEXT" type="xs:string" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="DialDiaparTabType">
    <xs:sequence>
      <xs:element name="item" type="DialDiaparType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DialType">
    <xs:sequence>
      <xs:element name="TDCT" type="DialTdctType" minOccurs="0"/>
      <xs:element name="DIA_PARS" type="DialDiaparTabType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
