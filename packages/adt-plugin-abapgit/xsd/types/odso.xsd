<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <!-- ODSO details (BAPI6116) -->
  <xs:complexType name="OdsoDetailsType">
    <xs:all>
      <xs:element name="ODSOBJECT" type="xs:string"/>
      <xs:element name="ODSOTYPE" type="xs:string" minOccurs="0"/>
      <xs:element name="OBJVERS" type="xs:string" minOccurs="0"/>
      <xs:element name="ODSASIZCAT" type="xs:string" minOccurs="0"/>
      <xs:element name="ODSADATCLS" type="xs:string" minOccurs="0"/>
      <xs:element name="NOEDSFL" type="xs:string" minOccurs="0"/>
      <xs:element name="KEY_NOT_UNIQUE" type="xs:string" minOccurs="0"/>
      <xs:element name="IMOFL" type="xs:string" minOccurs="0"/>
      <xs:element name="PLANNING_MODE" type="xs:string" minOccurs="0"/>
      <xs:element name="ACTVIEWGEN" type="xs:string" minOccurs="0"/>
      <xs:element name="TXTLG" type="xs:string" minOccurs="0"/>
      <xs:element name="TXTSH" type="xs:string" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <!-- ODSO InfoObjects (BAPI6116IO) -->
  <xs:complexType name="OdsoInfoObjectsItemType">
    <xs:all>
      <xs:element name="INFOBJECT" type="xs:string" minOccurs="0"/>
      <xs:element name="OBJVERS" type="xs:string" minOccurs="0"/>
      <xs:element name="KEYFLAG" type="xs:string" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="OdsoInfoObjectsType">
    <xs:sequence>
      <xs:element name="BAPI6116IO" type="OdsoInfoObjectsItemType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- NAVIGATION/INDEXES/INDEX_IOBJ: rows of arbitrary structure (lax) -->
  <xs:complexType name="OdsoAnyTableType">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
