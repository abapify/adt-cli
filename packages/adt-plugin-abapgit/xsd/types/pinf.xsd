<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:complexType name="PinfAttributesType">
    <xs:all>
      <xs:element name="PACK_NAME" type="xs:string" minOccurs="0"/>
      <xs:element name="INTF_NAME" type="xs:string" minOccurs="0"/>
      <xs:element name="DESCR" type="xs:string" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="PinfElementType">
    <xs:all>
      <xs:element name="PACK_NAME" type="xs:string" minOccurs="0"/>
      <xs:element name="INTF_NAME" type="xs:string" minOccurs="0"/>
      <xs:element name="ELEMENT_NAME" type="xs:string" minOccurs="0"/>
      <xs:element name="ELEMENT_TYPE" type="xs:string" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="PinfType">
    <xs:sequence>
      <xs:element name="ATTRIBUTES" type="PinfAttributesType" minOccurs="0"/>
      <xs:element name="ELEMENTS" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="item" type="PinfElementType" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
