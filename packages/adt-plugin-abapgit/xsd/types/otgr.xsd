<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:complexType name="OtgrTypeGroupType">
    <xs:all>
      <xs:element name="NAME" type="xs:string" minOccurs="0"/>
      <xs:element name="TYPE" type="xs:string" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="OtgrTextItemType">
    <xs:all>
      <xs:element name="SPRAS" type="xs:string" minOccurs="0"/>
      <xs:element name="NAME" type="xs:string" minOccurs="0"/>
      <xs:element name="TEXT" type="xs:string" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="OtgrElementType">
    <xs:all>
      <xs:element name="OBJ_TYPE_GROUP" type="xs:string" minOccurs="0"/>
      <xs:element name="OBJ_TYPE" type="xs:string" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="OtgrType">
    <xs:sequence>
      <xs:element name="CLS_TYPE_GROUP" type="OtgrTypeGroupType" minOccurs="0"/>
      <xs:element name="TEXTS" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="item" type="OtgrTextItemType" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="ELEMENTS" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="item" type="OtgrElementType" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
