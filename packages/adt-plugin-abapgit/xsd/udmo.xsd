<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:asx="http://www.sap.com/abapxml"
           elementFormDefault="unqualified">
  <xs:import namespace="http://www.sap.com/abapxml" schemaLocation="asx.xsd"/>
  <xs:include schemaLocation="abapgit.xsd"/>
  <xs:include schemaLocation="types/udmo.xsd"/>

  <xs:complexType name="UdmoValuesType">
    <xs:sequence>
      <xs:element name="DM40L" type="UdmoDm40lType" minOccurs="0"/>
      <xs:element name="UDMO_ENTITIES" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="item" type="UdmoEntityItemType" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="UDMO_TEXTS" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="item" type="UdmoTextItemType" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="UdmoAbapType">
    <xs:sequence>
      <xs:element name="values" type="UdmoValuesType"/>
    </xs:sequence>
    <xs:attribute name="version" type="xs:string" default="1.0"/>
  </xs:complexType>

  <xs:element name="abapGit">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="abap" type="UdmoAbapType"/>
      </xs:sequence>
      <xs:attribute name="version" type="xs:string" use="required"/>
      <xs:attribute name="serializer" type="xs:string" use="required"/>
      <xs:attribute name="serializer_version" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
