<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.sap.com/abapxml"
           xmlns:asx="http://www.sap.com/abapxml"
           elementFormDefault="unqualified">



  <xs:complexType name="SkeyType">
    <xs:all>
      <xs:element name="TYPE" type="xs:string" minOccurs="0"/>
      <xs:element name="NAME" type="xs:string" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="BindingType">
    <xs:all>
      <xs:element name="TYPE" type="xs:string" minOccurs="0"/>
      <xs:element name="VERSION" type="xs:string" minOccurs="0"/>
      <xs:element name="CATEGORY" type="xs:string" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <!-- Redefine AbapValuesType to include SRVB-specific elements -->
  <xs:redefine schemaLocation="asx.xsd">
    <xs:complexType name="AbapValuesType">
      <xs:complexContent>
        <xs:extension base="asx:AbapValuesType">
          <xs:sequence>
            <xs:element name="SKEY" type="asx:SkeyType" minOccurs="0"/>
                  <xs:element name="BINDING" type="asx:BindingType" minOccurs="0"/>
          </xs:sequence>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:redefine>

  <!-- Import abapGit root element -->
  <xs:import schemaLocation="abapgit.xsd"/>

</xs:schema>
