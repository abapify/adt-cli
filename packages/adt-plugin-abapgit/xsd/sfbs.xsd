<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:asx="http://www.sap.com/abapxml"
           elementFormDefault="unqualified">
  <xs:import namespace="http://www.sap.com/abapxml" schemaLocation="asx.xsd"/>
  <xs:include schemaLocation="abapgit.xsd"/>
  <xs:include schemaLocation="types/sfbs.xsd"/>

  <xs:complexType name="SfbsValuesType">
    <xs:sequence>
      <xs:element name="HEADER" type="SfbsHeaderType" minOccurs="0"/>
      <xs:element name="NAME32" type="xs:string" minOccurs="0"/>
      <xs:element name="NAME80" type="xs:string" minOccurs="0"/>
      <xs:element name="ASSIGNED_BF" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="item" type="SfbsAssignedBfItemType" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="NESTED_BFS" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="item" type="SfbsNestedBfsItemType" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="PARENT_BFS" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="item" type="SfbsParentBfsItemType" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="SfbsAbapType">
    <xs:sequence>
      <xs:element name="values" type="SfbsValuesType"/>
    </xs:sequence>
    <xs:attribute name="version" type="xs:string" default="1.0"/>
  </xs:complexType>

  <xs:element name="abapGit">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="abap" type="SfbsAbapType"/>
      </xs:sequence>
      <xs:attribute name="version" type="xs:string" use="required"/>
      <xs:attribute name="serializer" type="xs:string" use="required"/>
      <xs:attribute name="serializer_version" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
