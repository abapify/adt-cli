<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:asx="http://www.sap.com/abapxml"
           elementFormDefault="unqualified">
  <xs:import namespace="http://www.sap.com/abapxml" schemaLocation="asx.xsd"/>
  <xs:include schemaLocation="abapgit.xsd"/>
  <xs:include schemaLocation="types/tobj.xsd"/>

  <xs:complexType name="TobjValuesType">
    <xs:sequence>
      <xs:element name="OBJH" type="TobjObjhType" minOccurs="0"/>
      <xs:element name="OBJT" type="TobjObjtType" minOccurs="0"/>
      <xs:element name="TOBJ" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="TDDAT" type="TobjTddatType" minOccurs="0"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TobjAbapType">
    <xs:sequence>
      <xs:element name="values" type="TobjValuesType"/>
    </xs:sequence>
    <xs:attribute name="version" type="xs:string" default="1.0"/>
  </xs:complexType>

  <xs:element name="abapGit">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="abap" type="TobjAbapType"/>
      </xs:sequence>
      <xs:attribute name="version" type="xs:string" use="required"/>
      <xs:attribute name="serializer" type="xs:string" use="required"/>
      <xs:attribute name="serializer_version" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
