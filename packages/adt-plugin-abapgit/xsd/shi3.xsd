<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:asx="http://www.sap.com/abapxml"
           elementFormDefault="unqualified">
  <xs:import namespace="http://www.sap.com/abapxml" schemaLocation="asx.xsd"/>
  <xs:include schemaLocation="abapgit.xsd"/>
  <xs:include schemaLocation="types/shi3.xsd"/>

  <xs:complexType name="Shi3ValuesType">
    <xs:sequence>
      <xs:element name="TREE_HEAD" type="Shi3TreeHeadType" minOccurs="0"/>
      <xs:element name="TREE_TITLES" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="item" type="Shi3TreeTitleItemType" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="TREE_NODES" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="item" type="Shi3TreeNodeItemType" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Shi3AbapType">
    <xs:sequence>
      <xs:element name="values" type="Shi3ValuesType"/>
    </xs:sequence>
    <xs:attribute name="version" type="xs:string" default="1.0"/>
  </xs:complexType>

  <xs:element name="abapGit">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="abap" type="Shi3AbapType"/>
      </xs:sequence>
      <xs:attribute name="version" type="xs:string" use="required"/>
      <xs:attribute name="serializer" type="xs:string" use="required"/>
      <xs:attribute name="serializer_version" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
