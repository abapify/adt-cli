<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:asx="http://www.sap.com/abapxml" targetNamespace="http://www.sap.com/abapxml" elementFormDefault="unqualified">

  
  <xs:include schemaLocation="types/ensc.xsd" />

  
  <xs:redefine schemaLocation="asx.xsd">
