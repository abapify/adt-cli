{
  "name": "adt",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:adt", "type:app", "npm:public"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "cache": true,
      "inputs": [
        "default",
        "^production",
        {
          "runtime": "node -e \"process.stdout.write(require('node:crypto').createHash('sha256').update(require('node:fs').readFileSync('bun.lock')).digest('hex'))\""
        }
      ],
      "options": {
        "command": "bun build.ts",
        "cwd": "packages/adt"
      }
    }
  }
}
