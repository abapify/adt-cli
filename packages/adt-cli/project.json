{
  "name": "adt-cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/adt-cli/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["{projectRoot}"]
    }
  },
  "tags": [],
  "targets": {
    "test": {
      "dependsOn": ["build", "^build", "adt-mcp:build"]
    },
    "test:real": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx vitest run --config ./vitest.real.config.ts",
        "cwd": "{projectRoot}"
      },
      "cache": false,
      "dependsOn": ["build"]
    },
    "bundle": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun build --compile ./src/bin/adt-all.ts --outfile ./dist/adt --target bun",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/dist/adt"],
      "cache": true,
      "inputs": [
        "default",
        "^production",
        {
          "runtime": "node -e \"process.stdout.write(require('node:crypto').createHash('sha256').update(require('node:fs').readFileSync('bun.lock')).digest('hex'))\""
        }
      ],
      "dependsOn": ["^build"]
    }
  }
}
