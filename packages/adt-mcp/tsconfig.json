{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "references": [
    {
      "path": "../adt-services"
    },
    {
      "path": "../adt-schemas"
    },
    {
      "path": "../adt-rfc"
    },
    {
      "path": "../adt-plugin-abapgit"
    },
    {
      "path": "../adt-plugin"
    },
    {
      "path": "../adt-locks"
    },
    {
      "path": "../adt-lint"
    },
    {
      "path": "../adt-flow"
    },
    {
      "path": "../adt-contracts"
    },
    {
      "path": "../adt-config"
    },
    {
      "path": "../adt-client"
    },
    {
      "path": "../adt-atc"
    },
    {
      "path": "../adt-aunit"
    },
    {
      "path": "../adk"
    },
    {
      "path": "../adt-fixtures"
    }
  ]
}
