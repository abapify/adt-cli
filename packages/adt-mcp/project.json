{
  "name": "adt-mcp",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/adt-mcp/src",
  "projectType": "library",
  "tags": [
    "scope:adt",
    "type:mcp"
  ],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "packages/adt-mcp",
        "command": "bun dist/bin/adt-mcp-http.mjs",
        "envFile": "{workspaceRoot}/.env"
      }
    },
    "typecheck": {
      "command": "echo 'MISSING COVERAGE: typecheck disabled (MCP SDK + Zod OOM). Tracked: https://github.com/abapify/adt-cli/issues/311' && exit 1"
    }
  }
}
