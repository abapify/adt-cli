{
  "name": "adt-mcp",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/adt-mcp/src",
  "projectType": "library",
  "tags": ["scope:adt", "type:mcp"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "packages/adt-mcp",
        "command": "bun dist/bin/adt-mcp-http.mjs",
        "envFile": "{workspaceRoot}/.env"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/adt-mcp",
        "command": "NODE_OPTIONS=--max-old-space-size=6144 tsc -p tsconfig.json --noEmit"
      },
      "cache": true,
      "inputs": ["default", "^default"],
      "dependsOn": []
    }
  }
}
