{
  "name": "adt-plugin-gcts",
  "targets": {
    "codegen": {
      "command": "bun scripts/generate-aff-schemas.ts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "{workspaceRoot}/git_modules/abap-file-formats/file-formats/**/*-v*.json",
        "{projectRoot}/scripts/generate-aff-schemas.ts"
      ],
      "outputs": ["{projectRoot}/src/schemas/generated"]
    },
    "test": {
      "command": "node --import tsx --test tests/**/*.test.ts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "{projectRoot}/tests/**/*.ts",
        "{projectRoot}/src/**/*.ts",
        "{workspaceRoot}/git_modules/abap-file-formats/file-formats/**"
      ]
    },
    "aff-coverage": {
      "command": "bun scripts/aff-coverage.ts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "{workspaceRoot}/git_modules/abap-file-formats/file-formats/**",
        "{projectRoot}/src/lib/handlers/objects/*.ts",
        "{projectRoot}/scripts/aff-coverage.ts"
      ]
    }
  }
}
