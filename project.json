{
  "name": "abapify",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "namedInputs": {
    "rootNoop": ["{projectRoot}/project.json", "{projectRoot}/package.json"]
  },
  "targets": {
    "local-registry": {
      "executor": "@nx/js:verdaccio",
      "options": {
        "port": 4873,
        "config": ".verdaccio/config.yml",
        "storage": "tmp/local-registry/storage"
      }
    },
    "lint": {
      "executor": "nx:noop",
      "inputs": ["rootNoop"],
      "cache": false
    },
    "test": {
      "executor": "nx:noop",
      "inputs": ["rootNoop"],
      "cache": false
    },
    "typecheck": {
      "executor": "nx:noop",
      "inputs": ["rootNoop"],
      "cache": false
    },
    "e2e-ci": {
      "executor": "nx:noop",
      "inputs": ["rootNoop"],
      "cache": false
    }
  }
}
