# adt-mcp Docker Compose environment
# Copy this file to .env.mcp and fill in the values.
#   cp .env.mcp.example .env.mcp
#   docker compose -f docker-compose.mcp.yaml --env-file .env.mcp up
#
# Values here are interpolated into docker-compose.mcp.yaml and therefore
# describe paths *inside* the container — do not reuse the repo-root .env
# (its ../../cert.pem paths are relative to packages/adt-mcp and would
# silently override these container paths).

# ─── TLS (mandatory) ─────────────────────────────────────────────────────────
# PEM certificate/key served by the HTTPS listener. The defaults match the
# '${TLS_CERT_DIR:-./certs}:/app/certs:ro' volume mount — generate the pair
# into ./certs (see docs/deployment/mcp-http.md).
MCP_TLS_CERT=/app/certs/cert.pem
MCP_TLS_KEY=/app/certs/key.pem

# Host directory mounted at /app/certs inside the container. The container
# runs as uid 10001 — keep key.pem at mode 600 but assign it to that uid:
#   sudo chown 10001:10001 certs/key.pem
TLS_CERT_DIR=./certs

# TLS name the container healthcheck verifies — must match a DNS SAN on the
# certificate (e.g. mcp.example.com for CA-issued deployment certs).
MCP_HEALTH_HOST=localhost

# Optional: path (inside the container) to a CA bundle the healthcheck also
# trusts. Set when MCP_TLS_CERT is a leaf issued by a private CA — mount the
# CA into ./certs and use e.g. /app/certs/ca.pem.
# MCP_HEALTH_CA=

# ─── auth: pick exactly one mode ─────────────────────────────────────────────
# 1) bearer — shared secret. Leave empty for auth=none (loopback-only is
#    safe); generate a real secret when exposing beyond localhost:
#      openssl rand -hex 32
MCP_AUTH_TOKEN=
# 2) proxy — trust x-forwarded-user from a reverse proxy. Set to "1".
# TRUST_FORWARDED_AUTH=
# 3) oauth — validate an OIDC JWT directly against the IdP.
# OAUTH_ISSUER=
# OAUTH_AUDIENCE=
# OAUTH_JWKS_URI=
# OAUTH_REQUIRED_SCOPES=
# OAUTH_USER_CLAIM=

# Host-header allow-list (comma-separated). Set to your public hostname when
# exposing beyond localhost to defeat DNS-rebinding attacks.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS allow-list for browser clients (comma-separated).
# MCP_CORS_ORIGIN=

# ─── multi-system routing (optional) ─────────────────────────────────────────
# SAP_SYSTEMS_JSON='{"DEV":{"baseUrl":"https://dev.example.com:44300","client":"100"}}'
# SAP_SYSTEMS_FILE=/app/systems.json
